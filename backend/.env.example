# ============================================================
# Free-tier multi-provider setup (Omni-inspired simple version)
# Add as many free keys as you have. Router will try them in order.
# ============================================================

# Primary / default
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Free tier keys (leave empty if not used)
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
CEREBRAS_MODEL=llama-3.3-70b
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# If you run OmniRoute locally and want to point everything to it:
# LLM_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=any-key-you-created-in-omniroute
# LLM_MODEL=auto

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=

# Server
CORS_ORIGINS=http://localhost:5173,https://autonomous-coding-agent-tawny.vercel.app
HOST=0.0.0.0
PORT=8000
MAX_ITERATIONS=5
